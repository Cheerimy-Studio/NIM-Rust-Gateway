# ===== Aocker 管理器环境变量（screen 启动前 export，或写入启动脚本） =====
# 权威管理密码：设了就按它重置面板密码（启动时生效，用完请删除该变量）
#ZCM_ADMIN_PASSWORD=
# 脚本调用令牌（面板登录用密码，不走这个）：不设则首次启动随机生成写入 accounts.yaml
#ZCM_ADMIN_TOKEN=
# 监听地址
#ZCM_ADDR=0.0.0.0:9000
# 部署形态：auto / host（宿主机跑管理进程，默认）/ container（内部 DNS）
#ZCM_MODE=auto
# host 模式下每账号两个 127.0.0.1 端口槽位的起始值（zc 用 N，warp 用 N+1）
#ZCM_PORT_BASE=21100
# compose 项目名 / 容器网络名（多套部署并存时必须区分）
#ZCM_PROJECT=zcm
#ZCM_MESH=zcm-mesh
# 镜像覆盖
#ZCM_IMAGE_ZCODE=ghcr.io/tridefender/zcode-proxy:latest
#ZCM_IMAGE_WARP=caomingjun/warp:latest
# 流式响应空闲看门狗（秒）：相邻两块数据最大间隔
#ZCM_IDLE_TIMEOUT=300
# 后台循环间隔（秒）：健康 30 / 出口 300 / 配额 600 / 漂移自愈 300
#ZCM_HEALTH_INTERVAL=30
#ZCM_EGRESS_INTERVAL=300
#ZCM_QUOTA_INTERVAL=600
#ZCM_DRIFT_INTERVAL=300
